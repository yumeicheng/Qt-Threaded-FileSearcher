/* 1. 全局默认字体与背景 (注意这里改成了斜杠星号注释) */
        QWidget {
            background-color: #2b2b2b;
            color: #ffffff;
            font-family: "Microsoft YaHei", "Segoe UI"; /* 修正了 font */
            font-size: 10pt;                            /* 修正了 font */
        }

        /* 2. 输入框美化 */
        QLineEdit {
            background-color: #3e3e3e;     /* 修正了颜色代码 w -> e */
            border: 1px solid #555555;     /* 修正了 solid */
            border-radius: 4px;
            padding: 4px;
            selection-background-color: #4a90e2; /* 修正了颜色位数 */
        }

        /* 3. 按钮美化 */
        QPushButton {
            background-color: #4a90e2;
            color: white;
            border: none;
            border-radius: 4px;
            padding: 6px 12px;
            font-weight: bold;
        }
        QPushButton:hover {
            background-color: #357abd;
        }
        QPushButton:pressed {
            background-color: #2a5f9e;
        }
        QPushButton:disabled {
            background-color: #555555;
            color: #888888;
        }

        /* 4. 列表框美化 */
        QListWidget {
            background-color: #323232;
            border: 1px solid #555555;
            border-radius: 4px;
            outline: none;
        }
        QListWidget::item {
            padding: 6px;
        }
        QListWidget::item:selected {
            background-color: #4a90e2;
            color: white;
        }
        QListWidget::item:hover {
            background-color: #3e3e3e;
        }